---
const nav = [
  { label: 'Work', href: '/portfolio' },
  { label: 'Noises of AI', href: '/noises-of-ai' },
];

const currentPath = Astro.url.pathname;

// The homepage hero is full-bleed dark, so the header rides on top of it
// transparently and only takes on its own background once you scroll past.
const isOverlay = currentPath === '/';
---

<header class={`site-header ${isOverlay ? 'site-header--overlay' : ''}`}>
  <div class="header-inner">
    <a href="/" class="wordmark">ChenHsin Lee</a>

    <nav class="nav" aria-label="Primary navigation">
      <ul class="nav-list">
        {nav.map(({ label, href }) => (
          <li>
            <a
              href={href}
              class={`nav-link ${currentPath.startsWith(href) ? 'nav-link--active' : ''}`}
            >
              {label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a href="mailto:chenhsin.lee.531@gmail.com" class="header-cta btn btn--ghost-light">
      Say hello
    </a>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    background: rgba(14, 14, 14, 0.96);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border-dark);
    transition: background var(--duration-base) var(--ease-out);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--max-width-wide);
    margin-inline: auto;
    padding: 0 var(--space-4);
    height: 64px;
  }

  .wordmark {
    /* Newsreader, italic only: the one serif on the site. */
    font-family: var(--font-accent);
    font-size: 1.4rem;
    font-style: italic;
    font-weight: 500;
    color: var(--color-text-dark);
    letter-spacing: -0.01em;
    flex-shrink: 0;
  }

  .nav-list {
    display: flex;
    gap: var(--space-5);
  }

  .nav-link {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--color-text-dark-muted);
    transition: color var(--duration-fast);
    position: relative;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -3px;
    left: 0;
    width: 0;
    height: 1.5px;
    background: var(--color-accent);
    transition: width var(--duration-base) var(--ease-out);
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--color-text-dark);
  }

  .nav-link:hover::after,
  .nav-link--active::after {
    width: 100%;
  }

  .header-cta {
    padding: 8px 20px;
    font-size: 0.875rem;
    display: none;
  }

  @media (min-width: 640px) {
    .header-cta { display: inline-flex; }
  }

  @media (max-width: 480px) {
    .nav-list { gap: var(--space-3); }
  }

  /* ── Overlay variant (homepage hero) ──────────── */
  .site-header--overlay:not(.is-scrolled) {
    background: transparent;
    backdrop-filter: none;
    -webkit-backdrop-filter: none;
    border-bottom-color: transparent;
  }

  .site-header--overlay .header-inner {
    height: auto;
    padding: 40px 72px;
    transition: padding var(--duration-base) var(--ease-out);
  }

  .site-header--overlay.is-scrolled .header-inner {
    padding: 12px var(--space-4);
  }

  .site-header--overlay .wordmark {
    font-size: 22px;
    color: #fff;
  }

  .site-header--overlay .nav-list {
    gap: 44px;
  }

  .site-header--overlay .nav-link,
  .site-header--overlay .header-cta {
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.75);
  }

  .site-header--overlay .nav-link:hover,
  .site-header--overlay .nav-link--active { color: #fff; }

  .site-header--overlay .header-cta {
    padding: 11px 24px;
    border: 1px solid rgba(255,255,255,0.35);
  }

  .site-header--overlay .header-cta:hover {
    background: #fff;
    color: var(--hero-bg);
    border-color: #fff;
  }

  @media (max-width: 900px) {
    .site-header--overlay .header-inner { padding: 24px var(--space-4); }
    .site-header--overlay .nav-list { gap: var(--space-3); }
  }
</style>

<script>
  // Transparent over the hero, solid once the page scrolls under it.
  const overlayHeader = document.querySelector('.site-header--overlay');
  if (overlayHeader) {
    const sync = () => overlayHeader.classList.toggle('is-scrolled', window.scrollY > 40);
    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>

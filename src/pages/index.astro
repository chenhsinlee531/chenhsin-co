---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="ChenHsin Lee — PM who grows tools for thought">
  <!-- HERO -->
  <section class="hero" data-hero>
    <div class="hero-media" data-hero-media aria-hidden="true">
      <img src="/images/hero-photo.gif" alt="" class="hero-photo" />
      <span class="hero-photo-fade"></span>
    </div>

    <!-- Spotlight: dark by default, the cursor lifts the veil off the photo -->
    <div class="hero-spotlight" aria-hidden="true">
      <span class="hero-spotlight__rest"></span>
      <span class="hero-spotlight__light" data-hero-light></span>
    </div>

    <div class="hero-content">
      <p class="hero-tagline reveal">
        PM who grows tools for thought · SF / Taipei
      </p>
      <h1 class="hero-headline reveal reveal-delay-1">
        I build products that help people think,<br />
        create, and decide better, <span class="hero-headline__accent">not just faster.</span>
      </h1>
      <div class="hero-actions reveal reveal-delay-2">
        <a href="/portfolio" class="hero-btn hero-btn--solid">View work</a>
        <a href="/noises-of-ai" class="hero-btn hero-btn--outline">Read Noises of AI</a>
      </div>
    </div>

    <span class="hero-cursor" data-hero-cursor aria-hidden="true"></span>
  </section>

  <!-- ABOUT / EXPANDED INTRO -->
  <section class="about section-pad">
    <div class="about-inner">
      <div class="about-eyebrow label reveal">About</div>
      <div class="about-body">
        <p class="about-text reveal reveal-delay-1">
          My work keeps coming back to one question: how software meets the person behind the screen. What to speed up, what to slow down, what to leave entirely to them. I build where trust meets delight: discovery that feels personal for 10M+ listeners, and login that makes millions of daily transactions safe before money moves.
        </p>
        <p class="about-text reveal reveal-delay-2">
          What I think about most now is how AI reshapes creativity and judgment, and where the line should be. I write about that line, and the thinking behind my builds, in <a href="/noises-of-ai">Noises of AI</a>.
        </p>
        <div class="about-tags reveal reveal-delay-3">
          <span class="tag">Growth</span>
          <span class="tag">Consumer AI</span>
          <span class="tag">Creation & Thinking Tools</span>
          <span class="tag">Discovery & Personalization</span>
          <span class="tag">UX for AI</span>
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION PREVIEWS -->
  <section class="previews dark-section section-pad">
    <div class="container">
      <div class="previews-header reveal">
        <p class="label label--light">Selected work & writing</p>
      </div>
      <div class="previews-grid">

        <!-- Portfolio preview -->
        <a href="/portfolio" class="preview-card reveal">
          <div class="preview-card-image">
            <img src="/images/gif-product-tech.gif" alt="Product technology & new media" class="preview-gif" />
          </div>
          <div class="preview-card-body">
            <div class="preview-meta">
              <span class="label label--light">Portfolio</span>
              <span class="preview-arrow">→</span>
            </div>
            <h2 class="preview-title">The builds</h2>
            <p class="preview-desc">Selected work and AI experiments around discovery, trust, creativity, and judgment.</p>
            <span class="btn btn--ghost-light preview-btn">View case studies</span>
          </div>
        </a>

        <!-- Blog preview -->
        <a href="/noises-of-ai" class="preview-card reveal reveal-delay-1">
          <div class="preview-card-image">
            <img src="/images/gif-noises-of-ai.gif" alt="Noises of AI" class="preview-gif" />
          </div>
          <div class="preview-card-body">
            <div class="preview-meta">
              <span class="label label--light">Writing</span>
              <span class="preview-arrow">→</span>
            </div>
            <h2 class="preview-title">Noises of AI</h2>
            <p class="preview-desc">Notes on AI, media, and product judgment. What's worth building, what's overhyped, and what should stay human.</p>
            <span class="btn btn--ghost-light preview-btn">Read notes</span>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- CONTACT STRIP -->
  <section class="contact-strip section-pad--sm">
    <div class="container contact-inner">
      <p class="contact-line reveal">
        Open to conversations about consumer AI, growth, and how people will create and think with agents.
      </p>
      <a href="mailto:chenhsinlee@gmail.com" class="btn btn--primary reveal reveal-delay-1">
        Get in touch
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  /* ── HERO ─────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: 100svh;
    background: var(--hero-bg);
    overflow: hidden;
    cursor: none;
    /* Side of the moving light layer. Read back by the spotlight script. */
    --light-size: 1216px;
  }

  /* Layer 1 — the photo, bleeding into the black at its edges */
  .hero-media {
    position: absolute;
    top: 120px;
    left: 50%;
    transform: translateX(-46%);
    width: 608px;
    height: 608px;
    max-width: 100%;
    z-index: 1;
    pointer-events: none;
  }

  .hero-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.05);
  }

  /* Inset by 3px so the fade always covers the photo's own edge: no seam. */
  .hero-photo-fade {
    position: absolute;
    inset: -3px;
    background: radial-gradient(
      closest-side,
      rgba(0,0,0,0) 43%,
      rgba(0,0,0,0.62) 70%,
      #000 92%
    );
  }

  /* Layer 2 — the spotlight veil. Two layers that cross-fade: a static rest
     state, and a light that only ever moves. Nothing here repaints on
     mousemove, so the tracking runs on the compositor. */
  .hero-spotlight {
    position: absolute;
    inset: 0;
    z-index: 2;
    overflow: hidden;
    pointer-events: none;
  }

  .hero-spotlight__rest,
  .hero-spotlight__light {
    position: absolute;
    transition: opacity 0.18s linear;
  }

  .hero-spotlight__rest {
    inset: 0;
    opacity: 1;
    background: radial-gradient(
      620px 620px at calc(50% + 24px) 46%,
      rgba(0,0,0,0.45) 0%,
      rgba(0,0,0,0.75) 55%,
      rgba(0,0,0,0.95) 85%,
      #000 100%
    );
  }

  /* Twice the photo's width, so wherever the cursor goes the photo stays
     covered. Painted once, then translated. */
  .hero-spotlight__light {
    top: 0;
    left: 0;
    width: var(--light-size);
    height: var(--light-size);
    opacity: 0;
    will-change: transform;
    transform: translate3d(-2000px, -2000px, 0);
    background: radial-gradient(
      circle at 50% 50%,
      rgba(0,0,0,0.20) 0px,
      rgba(0,0,0,0.30) 100px,
      rgba(0,0,0,0.62) 230px,
      rgba(0,0,0,0.88) 340px,
      #000 430px
    );
  }

  /* Opacity is driven from the script: the light takes over from the rest
     state as the cursor nears the photo, and hands it back as it leaves. */

  /* Layer 3 — text */
  .hero-content {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 96px;
    z-index: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 26px;
    padding-inline: var(--space-4);
    text-align: center;
  }

  .hero-tagline {
    font-family: var(--font-accent);
    font-size: 21px;
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--hero-text-muted);
  }

  .hero-headline {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.6vw, 2.75rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: #fff;
  }

  .hero-headline__accent { color: var(--hero-magenta); }

  .hero-actions {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    justify-content: center;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    padding: 14px 28px;
    border-radius: 999px;
    font-family: var(--font-heading);
    font-size: 12px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    border: 1px solid transparent;
    transition: background var(--duration-fast) var(--ease-out),
                color var(--duration-fast) var(--ease-out),
                border-color var(--duration-fast) var(--ease-out);
    cursor: none;
  }

  .hero-btn--solid {
    background: #fff;
    color: var(--hero-bg);
    font-weight: 600;
    border-color: #fff;
  }
  .hero-btn--solid:hover {
    background: var(--hero-magenta);
    border-color: var(--hero-magenta);
    color: var(--hero-bg);
  }

  .hero-btn--outline {
    background: transparent;
    color: #fff;
    font-weight: 500;
    border-color: rgba(255,255,255,0.4);
  }
  .hero-btn--outline:hover {
    background: #fff;
    color: var(--hero-bg);
    border-color: #fff;
  }

  /* Layer 4 — custom cursor dot */
  .hero-cursor {
    position: fixed;
    top: 0;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--hero-magenta);
    pointer-events: none;
    z-index: 5;
    transform: translate3d(-100px, -100px, 0);
  }

  /* Touch / coarse pointers: no spotlight, no custom cursor. */
  @media (hover: none), (pointer: coarse) {
    .hero { cursor: auto; }
    .hero-btn { cursor: pointer; }
    .hero-cursor { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-spotlight__rest,
    .hero-spotlight__light { transition: none; }
  }

  @media (max-width: 900px) {
    .hero-media {
      top: 96px;
      width: min(608px, 80vw);
      height: min(608px, 80vw);
      transform: translateX(-50%);
    }
    .hero-spotlight__rest {
      background: radial-gradient(
        min(620px, 88vw) min(620px, 88vw) at 50% 40%,
        rgba(0,0,0,0.45) 0%,
        rgba(0,0,0,0.75) 55%,
        rgba(0,0,0,0.95) 85%,
        #000 100%
      );
    }
  }

  @media (max-width: 700px) {
    .hero-content { bottom: 64px; gap: 20px; }
    .hero-tagline { font-size: 18px; }
    .hero-headline br { display: none; }
    .hero-btn { padding: 13px 22px; }
  }

  /* ── ABOUT ────────────────────────────────────── */
  .about {
    background: var(--color-bg);
  }

  .about-inner {
    max-width: var(--max-width);
    margin-inline: auto;
    padding-inline: var(--space-4);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }

  @media (min-width: 768px) {
    .about-inner {
      grid-template-columns: 180px 1fr;
      gap: var(--space-7);
    }
  }

  .about-eyebrow {
    padding-top: 6px;
  }

  .about-text {
    font-size: var(--text-lg);
    line-height: var(--leading-loose);
    color: var(--color-text);
    margin-bottom: var(--space-4);
    max-width: 60ch;
  }

  .about-text a {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }

  .about-text a:hover {
    opacity: 0.7;
  }

  .about-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .tag {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 6px 14px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
  }

  /* ── PREVIEWS ─────────────────────────────────── */
  .previews-header {
    margin-bottom: var(--space-5);
  }

  .previews-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-3);
  }

  @media (min-width: 768px) {
    .previews-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .preview-card {
    display: flex;
    flex-direction: column;
    background: var(--color-bg-card-dark);
    border: 1px solid var(--color-border-dark);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: transform var(--duration-base) var(--ease-out),
                border-color var(--duration-base) var(--ease-out);
  }

  .preview-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .preview-card-image {
    aspect-ratio: 16/9;
    overflow: hidden;
  }

  .preview-gif {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .preview-card-body {
    padding: var(--space-4);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    flex: 1;
  }

  .preview-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .preview-arrow {
    font-size: var(--text-lg);
    color: var(--color-text-dark-muted);
    transition: transform var(--duration-fast) var(--ease-out),
                color var(--duration-fast);
  }

  .preview-card:hover .preview-arrow {
    transform: translateX(4px);
    color: var(--color-accent);
  }

  .preview-title {
    font-family: var(--font-heading);
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    color: var(--color-text-dark);
  }

  .preview-desc {
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--color-text-dark-muted);
    flex: 1;
  }

  .preview-btn {
    margin-top: var(--space-2);
    align-self: flex-start;
  }

  /* ── CONTACT STRIP ────────────────────────────── */
  .contact-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--space-3);
    border-top: 1px solid var(--color-border);
    padding-top: var(--space-5);
  }

  .contact-line {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }
</style>

<script>
  // Hero spotlight: the cursor is the light source, the photo is what it finds.
  // Fine pointers only — touch devices keep the static rest gradient.
  //
  // The light is a pre-painted layer that is only ever translated, and every
  // move collapses into one rAF write. No gradient is re-serialised per event,
  // which is what made the earlier version stutter.
  const hero = document.querySelector<HTMLElement>('[data-hero]');
  const media = document.querySelector<HTMLElement>('[data-hero-media]');
  const light = document.querySelector<HTMLElement>('[data-hero-light]');
  const cursor = document.querySelector<HTMLElement>('[data-hero-cursor]');
  const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');

  if (hero && media && light && cursor && finePointer.matches) {
    const size =
      parseFloat(getComputedStyle(hero).getPropertyValue('--light-size')) || 1216;

    // How far past the clamp the cursor travels before the light has fully
    // handed back to the rest state.
    const falloff = 240;

    const rest = document.querySelector<HTMLElement>('.hero-spotlight__rest');

    let heroLeft = 0;
    let heroTop = 0;
    let centerX = 0;
    let centerY = 0;
    let maxOffset = 0;
    let pointerX = 0;
    let pointerY = 0;
    let frame = 0;

    // Measured on load and on layout changes, never inside the move handler:
    // reading a rect there would force a layout on every event.
    const measure = () => {
      const heroRect = hero.getBoundingClientRect();
      const mediaRect = media.getBoundingClientRect();
      heroLeft = heroRect.left;
      heroTop = heroRect.top;
      centerX = mediaRect.left - heroLeft + mediaRect.width / 2;
      centerY = mediaRect.top - heroTop + mediaRect.height / 2;
      // The photo is already black past 46% of its box, so that disc is all
      // the light has to cover. Clamping there keeps the veil gap-free.
      maxOffset = Math.max(0, size / 2 - mediaRect.width * 0.46);
    };

    const clamp = (value: number, min: number, max: number) =>
      Math.min(Math.max(value, min), max);

    const render = () => {
      frame = 0;
      const rawX = pointerX - heroLeft;
      const rawY = pointerY - heroTop;
      const x = clamp(rawX, centerX - maxOffset, centerX + maxOffset);
      const y = clamp(rawY, centerY - maxOffset, centerY + maxOffset);

      // Past the clamp the light would sit on the photo without the cursor
      // being anywhere near it, so fade it out over that distance instead.
      const over = Math.max(Math.abs(rawX - x), Math.abs(rawY - y));
      const lit = 1 - clamp(over / falloff, 0, 1);

      light.style.transform =
        `translate3d(${x - size / 2}px, ${y - size / 2}px, 0)`;
      light.style.opacity = `${lit}`;
      if (rest) rest.style.opacity = `${1 - lit}`;
      cursor.style.transform =
        `translate3d(${pointerX - 6}px, ${pointerY - 6}px, 0)`;
    };

    const move = (event: MouseEvent) => {
      pointerX = event.clientX;
      pointerY = event.clientY;
      if (!frame) frame = requestAnimationFrame(render);
    };

    const leave = () => {
      if (frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
      light.style.opacity = '0';
      if (rest) rest.style.opacity = '1';
      cursor.style.transform = 'translate3d(-100px, -100px, 0)';
    };

    measure();
    hero.addEventListener('mousemove', move);
    hero.addEventListener('mouseleave', leave);
    window.addEventListener('resize', measure);
    window.addEventListener('scroll', measure, { passive: true });
  }
</script>

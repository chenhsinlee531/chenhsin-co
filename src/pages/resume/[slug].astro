---
// Resume links that point at one article: chenhsin.co/resume/ai-judgment.
// Same idea as /resume, one row per article in the Analytics Pages panel.
// BaseLayout points the canonical tag at the real article URL.
import { getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArticle from '../../components/Blog/PostArticle.astro';
import { ARTICLE_ALIASES } from '../../lib/tracking-paths';

const { slug } = Astro.params;
const aliased = ARTICLE_ALIASES[slug as string];

if (aliased) return Astro.redirect(`/resume/${aliased}`);

const entry = await getEntry('blog', slug as string);

if (!entry) return Astro.redirect('/noises-of-ai');

const { title, excerpt } = entry.data;
---

<BaseLayout title={`${title} — Noises of AI`} description={excerpt}>
  <PostArticle entry={entry} />
</BaseLayout>

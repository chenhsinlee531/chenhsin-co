---
// The URL printed on the resume. It serves the homepage under its own path, so
// Vercel Analytics counts resume clicks as a separate row in the Pages panel.
// Rendering the homepage component here (rather than Astro.rewrite) is what
// keeps the path distinct: the analytics script reads the path Astro rendered,
// and a rewrite reports the destination, not the URL the visitor opened.
// BaseLayout points the canonical tag at / and marks this path noindex.
import Home from './index.astro';
---

<Home />

---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/Shared/PageIntro.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .map(entry => ({ slug: entry.id.replace('.md', ''), ...entry.data }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
}
---

<BaseLayout title="Noises of AI — ChenHsin Lee" description="Notes on AI, media, and product judgment.">
  <PageIntro
    label="Writing"
    title="Noises of AI"
    description={"Notes on AI, media, and product judgment.\nWhat's worth building, what's overhyped, and what should stay human."}
  />

  <section class="blog-grid-section section-pad">
    <div class="container">
      {posts.length === 0 ? (
        <p class="empty-state label">Posts coming soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post, i) => (
            <li class="post-item">
              <a
                href={`/noises-of-ai/${post.slug}`}
                class="post-card reveal"
                style={`transition-delay: ${i * 60}ms`}
              >
                <div class="post-main">
                  <h2 class="post-title">{post.title}</h2>
                  {post.excerpt && <p class="post-excerpt">{post.excerpt}</p>}
                </div>

                <div class="post-meta">
                  <time class="post-date" datetime={post.date.toISOString().split('T')[0]}>
                    {formatDate(post.date)}
                  </time>
                  {post.tags?.length > 0 && (
                    <span class="post-tags">{post.tags.join(' · ')}</span>
                  )}
                </div>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-grid-section { background: var(--color-bg); }

  /* Title and summary lead; date and tags sit quietly to the right. */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--color-border);
  }

  .post-item { border-bottom: 1px solid var(--color-border); }

  .post-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-1);
    padding-block: 20px;
  }

  .post-title {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: 1.25rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-text);
    transition: color var(--duration-fast);
  }

  .post-card:hover .post-title { color: #7a641d; }

  .post-excerpt {
    margin-top: 4px;
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    column-gap: 8px;
    font-size: var(--text-xs);
    line-height: 1.7;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .post-tags::before {
    content: '·';
    margin-right: 8px;
  }

  @media (min-width: 720px) {
    .post-card {
      grid-template-columns: minmax(0, 1fr) 190px;
      column-gap: var(--space-4);
    }

    .post-meta {
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      padding-top: 4px;
    }

    .post-tags::before { content: none; }
  }

  .empty-state {
    text-align: center;
    padding: var(--space-8) 0;
    color: var(--color-text-muted);
  }
</style>

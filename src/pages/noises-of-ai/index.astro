---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/Shared/PageIntro.astro';

const allPosts = await getCollection('blog');
const posts = allPosts
  .map(entry => ({ slug: entry.id.replace('.md', ''), ...entry.data }))
  .sort((a, b) => b.date.getTime() - a.date.getTime());

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<BaseLayout title="Noises of AI — ChenHsin Lee" description="Notes on AI, media, and product judgment.">
  <PageIntro
    label="Writing"
    title="Noises of AI"
    description={"Notes on AI, media, and product judgment.\nWhat's worth building, what's overhyped, and what should stay human."}
  />

  <section class="blog-grid-section section-pad">
    <div class="container">
      {posts.length === 0 ? (
        <p class="empty-state label">Posts coming soon.</p>
      ) : (
        <ul class="post-list">
          {posts.map((post, i) => (
            <li class="post-item">
            <a
              href={`/noises-of-ai/${post.slug}`}
              class="post-card reveal"
              style={`transition-delay: ${i * 80}ms`}
            >
              <div class="post-card-inner">
                <div class="post-meta">
                  <time class="post-date label" datetime={post.date.toISOString().split('T')[0]}>
                    {formatDate(post.date)}
                  </time>
                  {post.tags?.length > 0 && (
                    <div class="post-tags">
                      {post.tags.map((tag: string) => (
                        <span class="post-tag">{tag}</span>
                      ))}
                    </div>
                  )}
                </div>

                <h2 class="post-title">{post.title}</h2>

                {post.excerpt && (
                  <p class="post-excerpt">{post.excerpt}</p>
                )}

                <span class="post-read label">Read →</span>
              </div>
            </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-grid-section { background: var(--color-bg); }

  /* List: one article per row */
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    max-width: 1000px;
    border-top: 1px solid var(--color-border);
  }

  .post-item { border-bottom: 1px solid var(--color-border); }

  .post-card { display: block; }

  .post-card-inner {
    padding-block: var(--space-5);
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  @media (min-width: 768px) {
    .post-card-inner {
      grid-template-columns: 200px 1fr;
      column-gap: var(--space-5);
    }

    .post-meta {
      grid-column: 1;
      grid-row: 1 / span 3;
      flex-direction: column;
      align-items: flex-start;
    }

    .post-title,
    .post-excerpt,
    .post-read { grid-column: 2; }
  }

  .post-card:hover .post-title { color: #7a641d; }

  .post-date { 
    color: var(--color-text-muted); 
    font-size: var(--text-xs);
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .post-tag {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    padding: 2px 8px;
    border-radius: var(--radius-full);
    background: var(--color-bg-card);
    color: var(--color-text-muted);
  }

  .post-title {
    /* Matches .project-title on the Work page: same card tier. */
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: var(--leading-tight);
    letter-spacing: -0.01em;
    color: var(--color-text);
  }

  .post-excerpt {
    font-size: var(--text-m);
    color: var(--color-text-muted);
    line-height: var(--leading-normal);
  }

  .post-read {
    margin-top: auto;
    color: var(--color-text-muted);
    font-size: 1rem;
    transition: color var(--duration-fast);
  }

  .post-card:hover .post-read { color: var(--color-accent); }

  .empty-state {
    text-align: center;
    padding: var(--space-8) 0;
    color: var(--color-text-muted);
  }
</style>
